
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flexbox Quest</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header class="header">
        <h1>⭐ Flexbox Quest</h1>
        <div>❤️ Lives: 3 | 🪙 Coins: 120 | Level: 1</div>
        <button>Pause</button>
    </header>

    <main>
        <section class="game">
            <h2>🌍 Adventure World</h2>
            <p>Collect all the stars!</p>
            <div class="scene">
                <span>🧙 Player</span>
                <span>⭐ Star</span>
                <span>🎁 Treasure</span>
            </div>
            <div class="platforms">
                <div>Platform</div>
                <div>Platform</div>
                <div>Platform</div>
            </div>
        </section>

        <section class="panels">

            <div class="panel">
                <h2>🎮 Controls</h2>
                <button>↑</button>
                <div>
                    <button>←</button>
                    <button>↓</button>
                    <button>→</button>
                </div>
                <button>JUMP!</button>
            </div>

            <div class="panel">
                <h2>🎒 Inventory</h2>
                <div class="items">
                    <span>⚔️ Sword</span>
                    <span>🛡️ Shield</span>
                    <span>🧪 Potion</span>
                    <span>🗝️ Key</span>
                </div>
            </div>

            <div class="panel">
                <h2>📜 Quests</h2>
                <p>Collect Stars — 1/3</p>
                <p>Find the Key — 0/1</p>
                <p>Defeat Monster — 0/1</p>
            </div>

        </section>
    </main>

    <footer>
        Flexbox Quest | Adventure Awaits! ⚔️
    </footer>

</body>
</html>
